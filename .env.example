# Скопируйте в .env командой cp .env.example .env и подставьте свои значения

# Уровень логирования DEBUG, INFO, WARNING или ERROR
LOG_LEVEL=INFO

# Подключение к Postgres, эти же переменные читает контейнер postgres в docker compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_equalizer

# Таймаут проверки каждой зависимости в /api/v1/health, секунды
HEALTH_TIMEOUT=2.0
